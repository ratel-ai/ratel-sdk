{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/sandbox/v1/create-version.response.schema.json",
  "title": "Create a sandbox version: response",
  "description": "201. The client sends the tar.gz to upload.url with upload.headers.",
  "type": "object",
  "required": [
    "versionId",
    "upload"
  ],
  "properties": {
    "versionId": {
      "type": "string",
      "format": "uuid"
    },
    "upload": {
      "type": "object",
      "required": [
        "method",
        "url"
      ],
      "properties": {
        "method": {
          "const": "PUT"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
