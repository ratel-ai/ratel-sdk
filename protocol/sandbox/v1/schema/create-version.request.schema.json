{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/sandbox/v1/create-version.request.schema.json",
  "title": "CreateVersionRequest",
  "description": "POST {RATEL_BASE_URL}/sandboxes/versions with a project key. It creates a version of an agent from an image tarball.",
  "type": "object",
  "required": ["config", "image", "bundle"],
  "properties": {
    "config": { "$ref": "ratel-yaml.schema.json", "description": "The parsed ratel.yaml." },
    "image": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "The image id (docker image inspect .Id)." },
        "platform": { "type": "string", "pattern": "^[a-z0-9]+/[a-z0-9_]+(/[a-z0-9]+)?$", "description": "e.g. linux/amd64." }
      }
    },
    "git": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "dirty": { "type": "boolean", "description": "Whether the folder of ratel.yaml has changes that are not committed." }
      }
    },
    "bundle": {
      "type": "object",
      "required": ["sha256", "bytes"],
      "description": "The gzip of `docker save` that the upload step sends.",
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
