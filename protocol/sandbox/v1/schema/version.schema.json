{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/sandbox/v1/version.schema.json",
  "title": "Version",
  "description": "The answer of POST {RATEL_BASE_URL}/sandboxes/versions/{id}/finalize (202) and GET {RATEL_BASE_URL}/sandboxes/versions/{id} (200). A version never changes, except for its status and its smoke result.",
  "type": "object",
  "required": ["versionId", "name", "status"],
  "properties": {
    "versionId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "status": { "enum": ["uploading", "uploaded", "preparing", "ready", "failed"], "description": "preparing: Ratel loads the image, runs the smoke check and saves a snapshot." },
    "reason": { "type": ["string", "null"], "description": "Why the version failed." },
    "image": { "type": "object", "properties": { "digest": { "type": "string" }, "platform": { "type": "string" } } },
    "git": { "type": ["object", "null"], "properties": { "commit": { "type": "string" }, "dirty": { "type": "boolean" } } },
    "bundle": { "type": "object", "properties": { "sha256": { "type": "string" }, "bytes": { "type": "integer" } } },
    "config": { "$ref": "ratel-yaml.schema.json" },
    "smoke": { "$ref": "#/$defs/smoke" },
    "createdAt": { "type": "string" },
    "url": { "type": "string", "pattern": "^https?://", "description": "The page of the version on Ratel." }
  },
  "$defs": {
    "smoke": {
      "type": "object",
      "description": "The smoke check: input.example with all tools simulated.",
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "output": { "description": "Any JSON." },
        "durationMs": { "type": "number", "minimum": 0 },
        "logs": { "type": "string", "description": "The container logs, redacted and capped." },
        "error": { "$ref": "error.schema.json#/$defs/errorBody" }
      },
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"] }
    }
  }
}
