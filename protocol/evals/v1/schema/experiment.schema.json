{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/evals/v1/experiment.schema.json",
  "title": "An experiment",
  "description": "The answer of GET /api/v1/evals/experiments/{id} (200). It has no captured text.",
  "type": "object",
  "required": [
    "v",
    "experimentId",
    "state",
    "url",
    "sandboxVersionId",
    "git",
    "params",
    "trialsPerCase",
    "counts",
    "cases",
    "createdAt",
    "finishedAt"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "experimentId": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "running",
        "completed"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "sandboxVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "git": {
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "params": {
      "type": "object"
    },
    "trialsPerCase": {
      "type": "integer",
      "minimum": 1
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "caseVersionId",
          "number",
          "name",
          "counts",
          "trials"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "caseVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "counts": {
            "$ref": "#/$defs/counts"
          },
          "trials": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/trial"
            }
          }
        }
      }
    },
    "baselineId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The run that the deltas compare with: the pinned baseline. Null: no baseline, or this run is the baseline. Only with the suite."
    },
    "verdict": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "ok",
            "verdict",
            "rule",
            "excludedMessage"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "verdict": {
              "enum": [
                "regressed",
                "improved",
                "unchanged",
                "inconclusive"
              ]
            },
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "excludedMessage": {
              "type": [
                "string",
                "null"
              ],
              "description": "Why some cases do not decide: the scorers of their eval differ. Null: each compared case decides."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ok",
            "reason",
            "message"
          ],
          "properties": {
            "ok": {
              "const": false
            },
            "reason": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ],
      "description": "The verdict of the run against the baseline, the same rule as the comparison. Null with no baseline. Only with the suite."
    },
    "evals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eval"
      },
      "description": "Each eval of the run with its score and its delta against the baseline. Only with the suite."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "required": [
        "pass",
        "fail",
        "invalid",
        "open"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "The number of trials with each result. `open` has no result yet."
    },
    "trial": {
      "type": "object",
      "required": [
        "trialId",
        "index",
        "result",
        "reason",
        "traceId",
        "sandboxRunId",
        "scorers"
      ],
      "properties": {
        "trialId": {
          "type": "string",
          "format": "uuid"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "invalid",
            null
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the trial is invalid."
        },
        "traceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sandboxRunId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "scorers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "gating",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "gating": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "not_scored"
                ]
              }
            }
          }
        }
      }
    },
    "eval": {
      "type": "object",
      "required": [
        "evalId",
        "name",
        "version",
        "cases",
        "counts",
        "score",
        "scorers",
        "delta",
        "deltaRefusal"
      ],
      "properties": {
        "evalId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "cases": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "The mean of the pass rates of the scorers over the valid trials, from 0 to 1. Null: no valid trial."
        },
        "scorers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scorerId",
              "name",
              "gating",
              "pass",
              "fail",
              "notScored",
              "passRate"
            ],
            "properties": {
              "scorerId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "gating": {
                "type": "boolean"
              },
              "pass": {
                "type": "integer",
                "minimum": 0
              },
              "fail": {
                "type": "integer",
                "minimum": 0
              },
              "notScored": {
                "type": "integer",
                "minimum": 0
              },
              "passRate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "delta": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "score",
                "scorers"
              ],
              "properties": {
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -1,
                  "maximum": 1
                },
                "scorers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "scorerId",
                      "delta"
                    ],
                    "properties": {
                      "scorerId": {
                        "type": "string"
                      },
                      "delta": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -1,
                        "maximum": 1
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "The score minus the score of the same eval in the baseline run. Null: no baseline, or see deltaRefusal."
        },
        "deltaRefusal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "reason",
                "message"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "not_in_baseline",
                    "scorers_differ"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          ],
          "description": "Why the eval has no delta against the baseline."
        }
      }
    }
  }
}
