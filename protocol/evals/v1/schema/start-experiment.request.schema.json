{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/evals/v1/start-experiment.request.schema.json",
  "title": "The request to start an experiment",
  "description": "The body of POST {RATEL_BASE_URL}/evals/experiments.",
  "type": "object",
  "required": ["sandboxVersion"],
  "properties": {
    "sandboxVersion": {
      "anyOf": [{ "const": "latest" }, { "type": "string", "minLength": 1 }],
      "description": "The id of an image version (protocol/sandbox/v1 version), or the newest version that is ready."
    },
    "trials": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 3,
      "description": "The trials for each case."
    },
    "params": {
      "type": "object",
      "description": "The parameter values that each run gets: a flat object of the parameters that ratel.yaml declares.",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Run only the approved cases with this label."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The name of the experiment."
    }
  }
}
