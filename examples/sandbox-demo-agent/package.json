{
  "name": "@ratel-ai/example-sandbox-demo-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "esbuild src/agent.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/agent.cjs --log-level=warning",
    "typecheck": "tsc",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@ratel-ai/sdk": "workspace:*",
    "@ratel-ai/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@ratel-ai/cli": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
