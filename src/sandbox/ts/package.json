{
  "name": "@ratel-ai/sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Define a Ratel sandbox for a TypeScript agent: the definition file, the runner in the instance and `ratel sandbox push`.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "author": "Agentified",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratel-ai/ratel-sdk.git",
    "directory": "src/sandbox/ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "test": "pnpm build && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  },
  "bin": {
    "ratel": "./dist/cli.js"
  }
}
