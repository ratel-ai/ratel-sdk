{
  "name": "@ratel-ai/cloud-sdk",
  "version": "0.7.0-rc.5",
  "description": "Deprecated: use @ratel-ai/sdk/platform, @ratel-ai/sdk/otel and @ratel-ai/sdk/platform/testing. This package re-exports them under the old entry points (root, /runtime, /otel, /testing) so that current imports continue to work.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "license": "MIT",
  "author": "Agentified",
  "homepage": "https://github.com/ratel-ai/ratel-sdk/tree/main/src/cloud-sdk/ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratel-ai/ratel-sdk.git",
    "directory": "src/cloud-sdk/ts"
  },
  "bugs": {
    "url": "https://github.com/ratel-ai/ratel-sdk/issues"
  },
  "keywords": [
    "skills",
    "skill-catalog",
    "ai-agents",
    "llm",
    "context-engineering",
    "opentelemetry",
    "otlp",
    "telemetry",
    "ratel"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "example:shim-e2e": "node --import ./examples/use-shim.mjs ../../../examples/platform/e2e.mjs && node --import ./examples/use-shim.mjs ../../../examples/platform/runtime-attach-e2e.mjs"
  },
  "dependencies": {
    "@ratel-ai/sdk": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.3.0 <1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": ">=0.221.0 <1.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": ">=0.220.0 <1.0.0",
    "@opentelemetry/sdk-logs": ">=0.221.0 <1.0.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-logs-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/sdk-logs": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
