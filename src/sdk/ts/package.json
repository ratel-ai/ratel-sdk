{
  "name": "@ratel-ai/sdk",
  "version": "0.14.0",
  "description": "TypeScript SDK for the Ratel Platform: runtime context for AI agents (BM25 tool retrieval, MCP ingestion, framework-neutral capability tools), plus sync and self-improvement through the platform.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "default": "./dist/testkit/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./platform/testing": {
      "types": "./dist/platform/testing/index.d.ts",
      "default": "./dist/platform/testing/index.js"
    },
    "./otel": {
      "types": "./dist/platform/otel/index.d.ts",
      "default": "./dist/platform/otel/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "Agentified",
  "homepage": "https://github.com/ratel-ai/ratel-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratel-ai/ratel-sdk.git",
    "directory": "src/sdk/ts"
  },
  "bugs": {
    "url": "https://github.com/ratel-ai/ratel-sdk/issues"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "tool-calling",
    "bm25",
    "retrieval",
    "context-engineering",
    "ratel"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "files": [
    "dist",
    "native/index.cjs",
    "native/index.d.cts",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:native": "napi build --platform --release --manifest-path native/Cargo.toml --output-dir native --js index.cjs --dts index.d.cts",
    "build:ts": "tsc",
    "build": "pnpm build:native && pnpm build:ts",
    "typecheck": "pnpm build:native && tsc --noEmit && tsc -p tsconfig.type-tests.json",
    "docs:check": "typedoc",
    "lint": "biome check src && pnpm docs:check",
    "test": "pnpm build:native && vitest run"
  },
  "napi": {
    "binaryName": "ratel-sdk",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@napi-rs/cli": "^3.11.1",
    "@opentelemetry/context-async-hooks": "^2.12.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/sdk-logs": "^0.223.2",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^24.19.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@ratel-ai/telemetry": "workspace:^",
    "@types/json-schema": "^7.0.15",
    "canonicalize": "^4.0.0"
  },
  "peerDependencies": {
    "@opentelemetry/exporter-logs-otlp-proto": ">=0.221.0 <1.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": ">=0.220.0 <1.0.0",
    "@opentelemetry/sdk-logs": ">=0.221.0 <1.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/exporter-logs-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/sdk-logs": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  }
}
