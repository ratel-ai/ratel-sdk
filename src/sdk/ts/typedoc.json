{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/testkit/index.ts",
    "src/serve/index.ts"
  ],
  "readme": "none",
  "emit": "none",
  "excludeInternal": true,
  "validation": {
    "notDocumented": true
  },
  "treatValidationWarningsAsErrors": true,
  "intentionallyNotExported": [
    "src/catalog.ts:ExclusiveEmbeddingFields",
    "src/platform/runtime/attach.ts:AttachOptions",
    "src/platform/runtime/intent-graph-sync.ts:IntentGraphSyncOptions",
    "src/platform/runtime/tool-picker.ts:ToolPickerMode",
    "src/platform/runtime/tool-picker.ts:ToolPicker",
    "src/platform/intents.ts:IntentsClient",
    "src/platform/jobs.ts:JobsClient",
    "src/platform/runtime-catalog.ts:RuntimeCatalogClient",
    "src/platform/skills.ts:SkillsClient",
    "src/platform/suggestions.ts:SuggestionsClient",
    "src/platform/runtime/delivery-status.ts:RuntimeDeliveryStatus",
    "src/platform/runtime/delivery-status.ts:DeliveryResult"
  ],
  "externalSymbolLinkMappings": {
    "@ratel-ai/telemetry": {
      "contentCaptureMode": "https://github.com/ratel-ai/ratel-sdk/blob/main/src/telemetry/ts/src/content-capture.ts"
    }
  }
}
